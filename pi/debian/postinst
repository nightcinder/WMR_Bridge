#!/bin/sh
# Create the service user and token on install/upgrade.
#
# DESTDIR + WMR_SKIP_PRIVILEGED=1 run the same steps against a staged rootfs
# without root, for pi/tools/dry_run.sh.
set -e

DESTDIR="${DESTDIR:-}"
DESTDIR="${DESTDIR%/}"
SKIP_PRIVILEGED="${WMR_SKIP_PRIVILEGED:-0}"
# Staged runs and tests can point at a fake systemd run directory instead of
# the real /run/systemd/system.
SYSTEMD_RUN_DIR="${WMR_SYSTEMD_RUN_DIR:-/run/systemd/system}"
ETC_DIR="${DESTDIR}/etc/wmr-bridge"
TOKEN_FILE="${ETC_DIR}/token"

case "$1" in
    configure)
        if [ "$SKIP_PRIVILEGED" != "1" ]; then
            if ! id -u wmr >/dev/null 2>&1; then
                useradd --system --create-home --groups input,bluetooth wmr 2>/dev/null || true
                if ! id -u wmr >/dev/null 2>&1; then
                    echo "wmr-bridge: could not create the 'wmr' user (missing 'input' or 'bluetooth' group?)" >&2
                    exit 1
                fi
            else
                usermod -aG input,bluetooth wmr 2>/dev/null || true
            fi
        fi

        mkdir -p "$ETC_DIR"
        if [ ! -s "$TOKEN_FILE" ]; then
            umask_old="$(umask)"
            umask 0077
            head -c 24 /dev/urandom | base64 > "$TOKEN_FILE"
            umask "$umask_old"
        fi
        chmod 0640 "$TOKEN_FILE"

        # Drop bytecode from a previous install so a stale .pyc can never
        # shadow the source files this package just unpacked.
        rm -rf "${DESTDIR}/opt/wmr-bridge/pi/wmr_bridge/__pycache__"

        if [ "$SKIP_PRIVILEGED" != "1" ]; then
            chown wmr:wmr "$TOKEN_FILE" || {
                echo "wmr-bridge: could not give ${TOKEN_FILE} to wmr:wmr" >&2
                exit 1
            }
            # The token is group-readable so the invoking admin can run the
            # host probe without sudo. Group membership applies on next login.
            if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "wmr" ] &&
                [ "$SUDO_USER" != "root" ]; then
                usermod -aG wmr "$SUDO_USER" 2>/dev/null || true
            fi
            # Stage the 5 GHz-preferred NetworkManager profile from the
            # unpacked tree. --no-reconnect leaves an SSH session on its
            # current link; the unit's ExecStartPre applies the preference when
            # the service starts. No NetworkManager or a 2.4 GHz-only radio is
            # non-fatal.
            if command -v nmcli >/dev/null 2>&1 &&
                [ -f "${DESTDIR}/opt/wmr-bridge/pi/wmr_bridge/__main__.py" ]; then
                (cd "${DESTDIR}/opt/wmr-bridge/pi" &&
                    python3 -m wmr_bridge --prefer-5ghz --no-reconnect) ||
                    echo "wmr-bridge: could not stage the 5 GHz Wi-Fi preference (non-fatal)" >&2
            fi
            if command -v udevadm >/dev/null 2>&1; then
                udevadm control --reload-rules || true
                udevadm trigger || true
            fi
            # BlueZ defaults JustWorksRepairing to "never", so bluetoothd
            # rejects a phone's fresh Just Works pairing against a stored bond
            # before our agent is asked ("Numeric comparison failed"). Route the
            # repair through the agent, as the ESP32 does after a stale bond
            # (ONY-441).
            BLUEZ_CONF="${DESTDIR}/etc/bluetooth/main.conf"
            BLUEZ_TOOL="${DESTDIR}/opt/wmr-bridge/pi/wmr_bridge/bluez_conf.py"
            BLUEZ_RESTART=0
            if command -v python3 >/dev/null 2>&1 && [ -f "$BLUEZ_TOOL" ]; then
                if python3 "$BLUEZ_TOOL" --check "$BLUEZ_CONF"; then
                    echo "wmr-bridge: BlueZ Just Works re-pairing already configured; leaving bluetooth.service running"
                elif python3 "$BLUEZ_TOOL" "$BLUEZ_CONF"; then
                    BLUEZ_RESTART=1
                else
                    echo "wmr-bridge: could not enable BlueZ Just Works re-pairing (non-fatal)" >&2
                fi
            fi
            if command -v rfkill >/dev/null 2>&1; then
                # Stock Pi OS ships Bluetooth soft-blocked; clear it before
                # the unit's own ExecStartPre runs so bluetoothd powers on.
                rfkill unblock bluetooth || true
            fi
            if [ -d "$SYSTEMD_RUN_DIR" ] && command -v systemctl >/dev/null 2>&1; then
                systemctl daemon-reload || true
                systemctl enable bluetooth.service || true
                if [ "$BLUEZ_RESTART" = "1" ]; then
                    # main.conf is read once at startup, so a policy change
                    # needs a bluetoothd restart. Stop the bridge first: a live
                    # GATT application, advertisement and Classic scan racing
                    # that restart can wedge the Pi's combo controller (btmon
                    # shows HCI Reset answered by Hardware Error 0x00, and only
                    # a cold power cycle clears it). An upgrade that does not
                    # change the policy leaves bluetoothd alone, so the bond and
                    # the working adapter survive.
                    systemctl stop wmr-bridge.service || true
                    systemctl restart bluetooth.service || true
                fi
                systemctl enable wmr-bridge.service || true
                systemctl restart wmr-bridge.service || true
                # Path-activated, root-run self-upgrade requested by the
                # daemon over an authenticated WebSocket.
                systemctl enable wmr-bridge-upgrade.path || true
                systemctl start wmr-bridge-upgrade.path || true
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
