[Unit]
Description=WMR Bridge Wi-Fi host bridge (BlueZ Classic BT to WebSocket)
Documentation=file:/opt/wmr-bridge/docs/PI_BRIDGE.md
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target

[Service]
Type=simple
User=wmr
Group=wmr
SupplementaryGroups=input bluetooth
WorkingDirectory=/opt/wmr-bridge/pi
EnvironmentFile=-/etc/wmr-bridge/wmr-bridge.env
# A stock Pi OS image soft-blocks Bluetooth via rfkill, and the service runs as
# wmr, which cannot clear it. Run this as root (the "+" prefix) before start.
# rfkill writes to /dev/rfkill, a character device, so it needs no extra
# address family. The daemon uses AF_INET/AF_INET6/AF_UNIX, and AF_NETLINK for
# `iw` cfg80211 queries and route/interface inspection.
ExecStartPre=-+/bin/sh -c 'command -v rfkill >/dev/null 2>&1 && rfkill unblock bluetooth'
# Bluetooth Classic shares the 2.4 GHz radio, so save a 5 GHz-preferred
# NetworkManager profile before the bridge starts. "+" runs this as root
# outside the wmr/NoNewPrivileges restrictions so nmcli can write the profile;
# "-" keeps a 2.4 GHz-only or unconfigured radio non-fatal.
ExecStartPre=-+/usr/bin/python3 -m wmr_bridge --prefer-5ghz
ExecStart=/usr/bin/python3 -m wmr_bridge --bind 0.0.0.0 --port 8765 --token-file /etc/wmr-bridge/token --advertise-mdns $WMR_BRIDGE_ARGS
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
