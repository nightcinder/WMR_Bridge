[Unit]
Description=WMR Bridge Wi-Fi host bridge (BlueZ Classic BT to WebSocket)
Documentation=file:/opt/wmr-bridge/docs/PI_BRIDGE.md
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target

[Service]
Type=simple
User=wmr
Group=wmr
SupplementaryGroups=input bluetooth
WorkingDirectory=/opt/wmr-bridge/pi
EnvironmentFile=-/etc/wmr-bridge/wmr-bridge.env
# /var/lib/wmr-bridge holds the upgrade trigger. StateDirectory makes it
# writable by wmr despite ProtectSystem=strict below.
StateDirectory=wmr-bridge
# The daemon uses AF_INET/AF_INET6/AF_UNIX, and AF_NETLINK for `iw` cfg80211
# queries and route/interface inspection.
#
# Do not run rfkill or the 5 GHz profile here. An upgrade restarts this unit;
# an unconditional nmcli switch or rfkill poke on every start competes with the
# radio and delays Bluetooth. rfkill runs in wmr-bridge-bt-recover.service when
# the daemon reports Adapter1.Powered=no, and the installer stages the 5 GHz
# profile once on a fresh install.
ExecStart=/usr/bin/python3 -m wmr_bridge --bind 0.0.0.0 --port 8765 --token-file /etc/wmr-bridge/token --advertise-mdns $WMR_BRIDGE_ARGS
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
