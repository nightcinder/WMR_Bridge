[Unit]
Description=Recover a powered-off WMR Bridge Bluetooth adapter
Documentation=file:/opt/wmr-bridge/docs/PI_BRIDGE.md
# The recovery ladder lives in wmr-bridge-bt-recover.sh: restarting bluetoothd
# alone does not reload a crashed Broadcom/Cypress firmware, and images
# differ in how the UART adapter is attached (the rc.2 image has no hciuart
# unit at all). The daemon already rate-limits triggers to one per 300 s
# (ADAPTER_RECOVERY_COOLDOWN_S in ble_gatt.py), so a start limit here would
# only add a silent lock-out after three failures; recovery must never lock
# itself out, so the interval is disabled outright.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
# Root-owned lock directory. The state directory is writable by the service
# user, and root's flock would follow a symlink planted at the lock name, so
# the lock must live in a directory only root can create or rename. Preserve
# it across runs: this oneshot's exit would otherwise remove the directory
# with the lock file inside, and a queued second trigger could then race a
# still-running recovery.
RuntimeDirectory=wmr-bridge-bt-recover
RuntimeDirectoryPreserve=yes
# The trigger file is intentionally ignored as input. Remove it before running
# so a failed recovery cannot re-trigger itself and nothing written to it can
# reach a shell command.
ExecStartPre=/bin/rm -f /var/lib/wmr-bridge/bt-recover.trigger
# Stop the daemon before touching bluetoothd: a live GATT application,
# advertisement and Classic scan racing the restart can wedge the combo
# controller. The helper clears the rfkill soft block, reloads the UART
# attach -- restarting hciuart only when `systemctl cat` proves the image
# ships it, else a btmgmt/hci_uart reset-rebind -- restarts bluetoothd and
# starts the daemon again; it logs each rung so the journal names the path
# taken, and exits 0 even when the adapter stays down.
ExecStart=/usr/bin/flock -n /run/wmr-bridge-bt-recover/recover.lock /opt/wmr-bridge/pi/systemd/wmr-bridge-bt-recover.sh
TimeoutStartSec=120
Nice=10
