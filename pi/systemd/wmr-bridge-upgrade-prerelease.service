[Unit]
Description=WMR Bridge pre-release upgrade (triggered by the bridge daemon)
Documentation=file:/opt/wmr-bridge/docs/PI_BRIDGE.md
# Do not use PartOf=/BindsTo the daemon: install.sh restarts wmr-bridge.service
# itself, and binding this oneshot to it would abort the install midway.
# Rate-limit repeated triggers from a bad or looping client.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
User=root
# Root-owned lock directory shared with wmr-bridge-upgrade.service. The state
# directory is writable by the service user, and root's flock would follow a
# symlink planted at the lock name, so the lock must live in a directory only
# root can create or rename. systemd removes this runtime directory when the
# oneshot stops.
RuntimeDirectory=wmr-bridge-upgrade
# Both trigger files are intentionally ignored as input. Remove both before
# running so a failed upgrade cannot re-trigger itself, nothing written to a
# trigger can reach the installer, and a stable trigger left behind does not
# start a second upgrade after this one.
ExecStartPre=/bin/rm -f /var/lib/wmr-bridge/upgrade.trigger /var/lib/wmr-bridge/upgrade-prerelease.trigger
# install.sh reads these to select a release. Clear them and use no
# EnvironmentFile= so the daemon-side trigger has no path to a URL, tag or
# version. The installer falls back to its release selection; --prerelease
# ranks stable and RC releases together.
Environment=WMR_BRIDGE_REPO= WMR_BRIDGE_RELEASE_BASE_URL= WMR_BRIDGE_TAG= WMR_BRIDGE_VERSION= WMR_BRIDGE_MINISIGN_PUBKEYS=
# Run only the root-owned installed copy. --upgrade forces the signed release
# fetch and exits 0 without reinstalling when the installed version is current
# (no reinstall or downgrade). The lock is shared with the stable service so
# overlapping runs fail closed.
ExecStart=/usr/bin/flock -n /run/wmr-bridge-upgrade/upgrade.lock /opt/wmr-bridge/pi/install.sh --upgrade --prerelease
TimeoutStartSec=900
Nice=10
